{
  "name": "react-tailwind-click-frame-animation",
  "version": "0.1.0",
  "description": "A lightweight, customizable React frame-by-frame animation component for mouse events (click, context menu, drag, and scroll) styled with Tailwind CSS.",
  "type": "module",
  "author": "ismetcetin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kagancetin/react-tailwind-click-frame-animation.git"
  },
  "homepage": "https://github.com/kagancetin/react-tailwind-click-frame-animation#readme",
  "bugs": {
    "url": "https://github.com/kagancetin/react-tailwind-click-frame-animation/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "react-tailwind-click-frame-animation": "./bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/index.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsup",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "deploy:demo": "npm run build:demo && gh-pages -d dist-demo",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "gh-pages": "^6.3.0",
    "lucide-react": "^1.16.0",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "keywords": [
    "react",
    "tailwind",
    "tailwindcss",
    "animation",
    "click-animation",
    "frame-animation",
    "mouse-events",
    "ui",
    "component"
  ]
}
